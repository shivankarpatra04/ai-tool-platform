# ─────────────────────────────────────────────────────────────
# AI Tools Platform — environment variables
# Copy this file to `.env.local` for local development, and set
# the same variables in your Vercel project (Settings → Environment
# Variables) for production.
# ─────────────────────────────────────────────────────────────

# REQUIRED — your NVIDIA NIM API key (used only on the server, never exposed
# to the browser). Get one at https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here

# OPTIONAL — endpoint and model. The values below are the built-in defaults
# used when these are unset, so you only need to override them to change models.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
